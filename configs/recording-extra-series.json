{
  "errors_total": "sum(http_server_requests_seconds_count{cj_scope=\"${scope}\",uri=\"/api/items/{id}\",status=~\"5..\"}) or vector(0)",
  "requests_total": "sum(http_server_requests_seconds_count{cj_scope=\"${scope}\",uri=\"/api/items/{id}\"})",
  "latency_mean": "sum(rate(http_server_requests_seconds_sum{cj_scope=\"${scope}\",uri=\"/api/items/{id}\"}[10s])) / sum(rate(http_server_requests_seconds_count{cj_scope=\"${scope}\",uri=\"/api/items/{id}\"}[10s]))",
  "request_rate": "sum(rate(http_server_requests_seconds_count{cj_scope=\"${scope}\",uri=\"/api/items/{id}\"}[10s]))",
  "heap_used": "sum(jvm_memory_used_bytes{cj_scope=\"${scope}\",area=\"heap\"})",
  "gc_pause_rate": "sum(rate(jvm_gc_pause_seconds_sum{cj_scope=\"${scope}\"}[10s])) or vector(0)"
}
