   "targets": [
    {
     "refId": "A",
     "expr": "max by (metric) (canaryjudge_evidence_share{canary=\"$canary\"})",
     "legendFormat": "{{metric}}",
     "datasource": {
      "type": "prometheus",
      "uid": "cj-prom"
     }
