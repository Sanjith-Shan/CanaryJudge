      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*canary.*"
      },
      "properties": [
       {
        "id": "color",
